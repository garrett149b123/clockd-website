---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  APP_STORE_URL,
  CTA_MICRO,
  CTA_PRIMARY,
  SUPPORT_EMAIL,
} from '../data/site';
import { formatRatingLabel, getAppStoreRating } from '../lib/appStoreRating';

const storeRating = await getAppStoreRating();
const ratingLabel = formatRatingLabel(storeRating.rating, storeRating.count);
const ratingCountLabel =
  storeRating.count === 1 ? '1 rating' : `${storeRating.count} ratings`;

const faqs = [
  {
    q: 'What is WorthIt?',
    a: 'WorthIt is an iPhone app that tells you if a shelf price is worth it. Snap an item, get a deal signal and typical prices, then buy or walk.',
  },
  {
    q: 'How does a scan work?',
    a: 'Photograph the item and include the shelf price when you can. WorthIt names it, shows a typical range, and compares Amazon, Walmart, and Target. Results are estimates, not live register prices.',
  },
  {
    q: 'What are Save, Flip, lists, and receipts?',
    a: 'Save is the shelf check. Flip opens resale comps on the same photo. A grocery list compares nearby stores for one trip. A receipt snap logs the store, items, and total after checkout.',
  },
  {
    q: 'Is WorthIt free?',
    a: 'Yes. WorthIt is free on the App Store, with a daily scan limit. WorthIt Pro raises that limit and removes ads while analyzing. No credit card needed to download.',
  },
];

const testimonials = [
  {
    quote: 'One snap and I knew the shelf tag wasn’t a deal. Put it back before I wasted the trip.',
    name: 'Alex M.',
    detail: 'Early tester · grocery shopper',
    initials: 'AM',
  },
  {
    quote: 'I typed my staples, compared nearby stores, and picked the cheaper one-stop trip in under a minute.',
    name: 'Jordan L.',
    detail: 'Early tester · list compare',
    initials: 'JL',
  },
  {
    quote: 'Scanned a thrift find, flipped to resale on the same photo, and skipped a bad buy.',
    name: 'Riley S.',
    detail: 'Early tester · Flip',
    initials: 'RS',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const stars = '★★★★★';
---

<BaseLayout faqJsonLd={faqLd} appStoreRating={storeRating}>
  <main id="main">
    <section class="hero">
      <div class="hero-atmosphere" aria-hidden="true">
        <div class="blob blob-lime"></div>
        <div class="blob blob-mint"></div>
      </div>
      <div class="container hero-grid">
        <div>
          <div class="hero-mascot-row">
            <img class="hero-mark" src="/assets/logo-mark.svg" alt="" width="72" height="72" />
            <p class="kicker">SNAP AN ITEM</p>
          </div>
          <h1>Worth it—or walk away.</h1>
          <p class="hero-lead">
            Snap an item and see if the shelf price is worth it. Save compares Amazon, Walmart, and Target.
            Flip checks resale on the same photo. Lists and receipts live in the same app.
          </p>
          <div class="badge-row">
            <span class="badge">Save at the shelf</span>
            <span class="badge badge-mint">Flip for profit</span>
          </div>
          <div class="hero-actions">
            <div class="cta-stack">
              <a class="btn btn-lime btn-hero" href={APP_STORE_URL}>{CTA_PRIMARY}</a>
              <p class="cta-micro">{CTA_MICRO}</p>
            </div>
            <a class="btn btn-ghost" href="#see-it">Watch a scan</a>
          </div>
          <p
            class="rating-note"
            data-app-store-rating
            aria-label={`Rated ${storeRating.rating.toFixed(1)} out of 5 on the App Store from ${ratingCountLabel}`}
          >
            <span class="rating-stars" aria-hidden="true">{stars}</span>
            <span data-app-store-rating-value>{ratingLabel}</span>
          </p>
        </div>
        <div class="hero-phone-wrap">
          <div class="demo-reel" aria-label="WorthIt scan demo: home to Save result">
            <picture>
              <source srcset="/screenshots/home.webp" type="image/webp" />
              <img
                class="demo-frame demo-frame-a"
                src="/screenshots/home.png"
                alt=""
                width="360"
                height="728"
                decoding="async"
                aria-hidden="true"
              />
            </picture>
            <picture>
              <source srcset="/screenshots/save.webp" type="image/webp" />
              <img
                class="demo-frame demo-frame-b"
                src="/screenshots/save.png"
                alt="WorthIt Save result with Solid Deal and Amazon, Walmart, Target comps"
                width="360"
                height="728"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
          <p class="hero-caption">In-app scan → deal signal + online comps</p>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="how-it-works">
      <div class="container">
        <div class="section-head">
          <p class="kicker">HOW IT WORKS</p>
          <h2>Three steps in the aisle.</h2>
          <p>Point at the item. See the shelf call. Then save, flip, or walk.</p>
        </div>
        <div class="steps">
          <article class="step">
            <div class="step-num">1</div>
            <h3>Snap an item</h3>
            <p>Photograph the product. Include the shelf price when you can.</p>
          </article>
          <article class="step">
            <div class="step-num">2</div>
            <h3>See if it’s worth it</h3>
            <p>Get a deal signal, a typical range, and Amazon, Walmart, and Target comps.</p>
          </article>
          <article class="step">
            <div class="step-num">3</div>
            <h3>Save, flip, or walk</h3>
            <p>Keep the grocery deal, check resale on the same photo, or put it back.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="see-it">
      <div class="container">
        <div class="section-head">
          <p class="kicker">IN THE APP</p>
          <h2>Save, Flip, lists, and receipts.</h2>
          <p>
            The first job is the shelf decision. Flip, a grocery list, and a receipt snap are the same WorthIt app
            when you need them.
          </p>
        </div>
        <div class="feature-grid">
          <article class="feature-card">
            <div class="feature-copy">
              <span class="feature-tag feature-tag-lime">SAVE</span>
              <h3>Is the shelf price worth it?</h3>
              <p>
                WorthIt names the item, shows a typical range, and compares Amazon, Walmart, and Target so you can
                decide before it goes in the cart.
              </p>
            </div>
            <div class="feature-shot">
              <picture>
                <source srcset="/screenshots/save.webp" type="image/webp" />
                <img src="/screenshots/save.png" alt="WorthIt Save result with a deal signal and Amazon, Walmart, and Target prices" width="360" height="728" loading="lazy" decoding="async" />
              </picture>
            </div>
          </article>
          <article class="feature-card reverse">
            <div class="feature-copy">
              <span class="feature-tag">FLIP</span>
              <h3>Spot flip profit on the same scan.</h3>
              <p>
                Open Flip after Save for a resale range, estimated profit, and a buy-or-pass signal. One photo, two
                questions.
              </p>
            </div>
            <div class="feature-shot">
              <picture>
                <source srcset="/screenshots/flip.webp" type="image/webp" />
                <img src="/screenshots/flip.png" alt="WorthIt Flip result with estimated resale profit" width="360" height="728" loading="lazy" decoding="async" />
              </picture>
            </div>
          </article>
        </div>
        <div class="shot-strip shot-follow">
          <figure class="shot-card">
            <picture>
              <source srcset="/screenshots/list.webp" type="image/webp" />
              <img src="/screenshots/list.png" alt="WorthIt grocery list compare across nearby stores" width="360" height="728" loading="lazy" decoding="async" />
            </picture>
            <figcaption>List — cheapest one-stop trip</figcaption>
          </figure>
          <figure class="shot-card">
            <picture>
              <source srcset="/screenshots/receipt.webp" type="image/webp" />
              <img src="/screenshots/receipt.png" alt="WorthIt receipt with store, items, and total" width="360" height="728" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Receipt — log the whole run</figcaption>
          </figure>
          <figure class="shot-card">
            <picture>
              <source srcset="/screenshots/activity.webp" type="image/webp" />
              <img src="/screenshots/activity.png" alt="WorthIt activity with grocery saved and flip profit" width="360" height="728" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Activity — track what counts</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="social-proof">
      <div class="container">
        <div class="section-head">
          <p class="kicker">EARLY FEEDBACK</p>
          <h2>Shoppers who hate guessing in the aisle.</h2>
          <p data-app-store-rating>
            Rated <span data-app-store-rating-value>{storeRating.rating.toFixed(1)} on the App Store · {ratingCountLabel}</span>.
            <a href={APP_STORE_URL}>Leave a review</a> after your first scan — it helps the next shopper trust WorthIt.
          </p>
        </div>
        <div class="testimonial-grid">
          {testimonials.map((t) => (
            <blockquote class="testimonial">
              <div class="testimonial-avatar" aria-hidden="true">{t.initials}</div>
              <p class="testimonial-quote">“{t.quote}”</p>
              <footer>
                <cite class="testimonial-name">{t.name}</cite>
                <span class="testimonial-detail">{t.detail}</span>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="built-by">
      <div class="container founder">
        <div class="founder-avatar" aria-hidden="true">GS</div>
        <div>
          <p class="kicker">BUILT BY</p>
          <h2>Garrett Spoor</h2>
          <p>
            I built WorthIt for the second before an item goes in the cart: snap it, see if the shelf price is worth
            it, then save, flip, or walk. Independent indie app. Questions?
            <a href={`mailto:${SUPPORT_EMAIL}`}>Email me</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="faq">
      <div class="container">
        <div class="section-head">
          <p class="kicker">FAQ</p>
          <h2>Simple answers.</h2>
          <p>What WorthIt is, how a scan works, and what it costs.</p>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band">
      <h2>Worth it—or walk away.</h2>
      <p class="diff-line diff-line-on-dark">
        Snap an item. WorthIt compares the shelf price to Amazon, Walmart, and Target before you buy.
      </p>
      <p>Free to download. Daily scan limit on the free plan — WorthIt Pro if you scan a lot.</p>
      <div class="cta-stack cta-stack-center">
        <a class="btn btn-lime btn-hero" href={APP_STORE_URL}>{CTA_PRIMARY}</a>
        <p class="cta-micro cta-micro-on-dark">{CTA_MICRO}</p>
      </div>
    </section>
  </main>
</BaseLayout>
