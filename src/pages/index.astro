---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  APP_STORE_URL,
  CTA_MICRO,
  CTA_PRIMARY,
  SUPPORT_EMAIL,
} from '../data/site';
import { formatRatingLabel, getAppStoreRating } from '../lib/appStoreRating';

const storeRating = await getAppStoreRating();
const ratingLabel = formatRatingLabel(storeRating.rating, storeRating.count);
const ratingCountLabel =
  storeRating.count === 1 ? '1 rating' : `${storeRating.count} ratings`;

const faqs = [
  {
    q: 'What is Clockd?',
    a: 'Clockd is an iPhone app that tells you if a shelf price is worth it. Snap the tag, see a deal signal and typical prices, then buy or walk.',
  },
  {
    q: 'How does a scan work?',
    a: 'Photograph the item with the price tag in frame when you can. Clockd identifies it and shows a typical range plus online prices. Results are estimates, not live register prices.',
  },
  {
    q: 'What else can I do?',
    a: 'Same app: type a grocery list and compare nearby stores, check resale on the same photo, or snap a receipt after checkout. You do not have to use those until you want them.',
  },
  {
    q: 'Is Clockd free?',
    a: 'Yes. Clockd is free on the App Store, with a daily scan limit. Clockd Pro raises that limit and removes ads while analyzing. No credit card needed to download.',
  },
];

const testimonials = [
  {
    quote: 'One snap and I knew the shelf tag wasn’t a deal. Put it back before I wasted the trip.',
    name: 'Alex M.',
    detail: 'Early tester · grocery shopper',
    initials: 'AM',
  },
  {
    quote: 'I typed my staples, compared nearby stores, and picked the cheaper one-stop trip in under a minute.',
    name: 'Jordan L.',
    detail: 'Early tester · list compare',
    initials: 'JL',
  },
  {
    quote: 'Scanned a thrift find, flipped to resale on the same photo, and skipped a bad buy.',
    name: 'Riley S.',
    detail: 'Early tester · Flip',
    initials: 'RS',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const stars = '★★★★★';
---

<BaseLayout faqJsonLd={faqLd} appStoreRating={storeRating}>
  <main id="main">
    <section class="hero">
      <div class="hero-atmosphere" aria-hidden="true">
        <div class="blob blob-lime"></div>
        <div class="blob blob-mint"></div>
      </div>
      <div class="container hero-grid">
        <div>
          <p class="kicker">GROCERY PRICE SCANNER</p>
          <h1>One snap tells you if that grocery price is actually a deal.</h1>
          <p class="hero-lead">
            Snap a shelf tag for a deal signal, typical range, and comps vs Amazon, Walmart, and Target.
            Worth it—or walk away.
          </p>
          <div class="hero-actions">
            <div class="cta-stack">
              <a class="btn btn-lime btn-hero" href={APP_STORE_URL}>{CTA_PRIMARY}</a>
              <p class="cta-micro">{CTA_MICRO}</p>
            </div>
            <a class="btn btn-ghost" href="#see-it">Watch a scan</a>
          </div>
          <p
            class="rating-note"
            data-app-store-rating
            aria-label={`Rated ${storeRating.rating.toFixed(1)} out of 5 on the App Store from ${ratingCountLabel}`}
          >
            <span class="rating-stars" aria-hidden="true">{stars}</span>
            <span data-app-store-rating-value>{ratingLabel}</span>
          </p>
        </div>
        <div class="hero-phone-wrap">
          <div class="demo-reel" aria-label="Clockd scan demo: home to Save result">
            <picture>
              <source srcset="/screenshots/home.webp" type="image/webp" />
              <img
                class="demo-frame demo-frame-a"
                src="/screenshots/home.png"
                alt=""
                width="360"
                height="728"
                decoding="async"
                aria-hidden="true"
              />
            </picture>
            <picture>
              <source srcset="/screenshots/save.webp" type="image/webp" />
              <img
                class="demo-frame demo-frame-b"
                src="/screenshots/save.png"
                alt="Clockd Save result with Solid Deal and Amazon, Walmart, Target comps"
                width="360"
                height="728"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
          <p class="hero-caption">In-app scan → deal signal + online comps</p>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="how-it-works">
      <div class="container">
        <div class="section-head">
          <p class="kicker">HOW IT WORKS</p>
          <h2>Three steps in the aisle.</h2>
          <p>No modes to pick up front. Point, scan, decide.</p>
        </div>
        <div class="steps">
          <article class="step">
            <div class="step-num">1</div>
            <h3>Snap the tag</h3>
            <p>Photograph the item. Include the shelf price when you can.</p>
          </article>
          <article class="step">
            <div class="step-num">2</div>
            <h3>See the deal</h3>
            <p>Get a clear signal, a typical price range, and Amazon / Walmart / Target comps.</p>
          </article>
          <article class="step">
            <div class="step-num">3</div>
            <h3>Buy or walk</h3>
            <p>If it isn’t worth it, put it back. If it is, check out with confidence.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="see-it">
      <div class="container">
        <div class="section-head">
          <p class="kicker">IN THE APP</p>
          <h2>See the product, not just the pitch.</h2>
          <p>
            Unlike Flipp or basket apps that stop at coupons or lists, Clockd is built for the shelf decision —
            Save, Flip, list, and receipt in one place.
          </p>
        </div>
        <div class="shot-strip">
          <figure class="shot-card">
            <picture>
              <source srcset="/screenshots/save.webp" type="image/webp" />
              <img src="/screenshots/save.png" alt="Clockd Save mode deal signal and online compare" width="360" height="728" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Save — shelf vs online</figcaption>
          </figure>
          <figure class="shot-card">
            <picture>
              <source srcset="/screenshots/list.webp" type="image/webp" />
              <img src="/screenshots/list.png" alt="Clockd grocery list compare across nearby stores" width="360" height="728" loading="lazy" decoding="async" />
            </picture>
            <figcaption>List — cheapest one-stop trip</figcaption>
          </figure>
          <figure class="shot-card">
            <picture>
              <source srcset="/screenshots/receipt.webp" type="image/webp" />
              <img src="/screenshots/receipt.png" alt="Clockd receipt trip with store, items, and total" width="360" height="728" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Receipt — log the whole run</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="social-proof">
      <div class="container">
        <div class="section-head">
          <p class="kicker">EARLY FEEDBACK</p>
          <h2>Shoppers who hate guessing in the aisle.</h2>
          <p data-app-store-rating>
            Rated <span data-app-store-rating-value>{storeRating.rating.toFixed(1)} on the App Store · {ratingCountLabel}</span>.
            <a href={APP_STORE_URL}>Leave a review</a> after your first scan — it helps the next shopper trust Clockd.
          </p>
        </div>
        <div class="testimonial-grid">
          {testimonials.map((t) => (
            <blockquote class="testimonial">
              <div class="testimonial-avatar" aria-hidden="true">{t.initials}</div>
              <p class="testimonial-quote">“{t.quote}”</p>
              <footer>
                <cite class="testimonial-name">{t.name}</cite>
                <span class="testimonial-detail">{t.detail}</span>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="built-by">
      <div class="container founder">
        <div class="founder-avatar" aria-hidden="true">GS</div>
        <div>
          <p class="kicker">BUILT BY</p>
          <h2>Garrett Spoor</h2>
          <p>
            I built Clockd after one too many aisle moments of “is this actually a deal?” Coupons and shopping lists
            help after you’ve already decided — Clockd is for the second before you put it in the cart. Independent
            indie app. Questions? <a href={`mailto:${SUPPORT_EMAIL}`}>Email me</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="features">
      <div class="container feature-grid">
        <article class="feature-card">
          <div class="feature-copy">
            <span class="feature-tag">THE SCAN</span>
            <h3>Is the shelf price worth it?</h3>
            <p>
              That is the whole app the first time you open it. Clockd names the item, shows a typical range, and
              compares Amazon, Walmart, and Target so you can decide in seconds.
            </p>
          </div>
          <div class="feature-shot">
            <picture>
              <source srcset="/screenshots/flip.webp" type="image/webp" />
              <img src="/screenshots/flip.png" alt="Clockd Flip result with resale profit estimate" width="360" height="728" loading="lazy" decoding="async" />
            </picture>
          </div>
        </article>
      </div>

      <div class="container also">
        <p class="also-kicker">Later, if you want</p>
        <div class="also-grid">
          <article class="also-card">
            <h3>Grocery list</h3>
            <p>Type milk, eggs, Cheerios. Clockd prices the basket at nearby stores.</p>
          </article>
          <article class="also-card">
            <h3>Flip</h3>
            <p>Same photo, resale range and estimated profit—for thrift finds.</p>
          </article>
          <article class="also-card">
            <h3>Receipts</h3>
            <p>Snap the tape after checkout. Clockd logs the store, items, and total.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="container">
        <div class="section-head">
          <p class="kicker">FAQ</p>
          <h2>Simple answers.</h2>
          <p>What Clockd is, how a scan works, and what it costs.</p>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band">
      <h2>Download Clockd free on iPhone.</h2>
      <p class="diff-line diff-line-on-dark">
        The only app that compares shelf price to Amazon, Walmart, and Target in one snap.
      </p>
      <p>No credit card to download. Daily scan limit on free — Pro if you scan a lot.</p>
      <div class="cta-stack cta-stack-center">
        <a class="btn btn-lime btn-hero" href={APP_STORE_URL}>{CTA_PRIMARY}</a>
        <p class="cta-micro cta-micro-on-dark">{CTA_MICRO}</p>
      </div>
    </section>
  </main>
</BaseLayout>
