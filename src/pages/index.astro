---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_STORE_URL } from '../data/site';

const faqs = [
  {
    q: 'What is Clockd?',
    a: 'Clockd is an iPhone grocery price scanner. Snap a shelf tag to see if the price is worth it, compare a shopping list at nearby grocers, log a receipt after checkout, or check resale comps on the same scan.',
  },
  {
    q: 'How does the grocery price scanner work?',
    a: 'Open Scan, photograph the item with the price tag in frame when you can, and Clockd runs a Save analysis. You get a deal signal, a typical price range, nearby store comparisons, and shop links. Results are AI estimates, not live register prices.',
  },
  {
    q: 'Can I compare a whole grocery list?',
    a: 'Yes. Type staples like milk, eggs, or Cheerios, then tap Compare. Clockd prices the basket at nearby grocers in one lookup and shows average vs brand so you can pick the cheapest one-stop trip.',
  },
  {
    q: 'Does Clockd help with flipping or resale?',
    a: 'Flip mode uses the same scan. You can check estimated resale range, profit after fees, and marketplace comps without photographing the item again. Helpful for thrift and resale finds.',
  },
  {
    q: 'Is Clockd free on iPhone?',
    a: 'Yes. Clockd is free to download on the App Store. Free includes a daily analysis limit. Clockd Pro unlocks 60 analyses per day and ad-free analyzing.',
  },
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout jsonLd={faqLd}>
  <main>
    <section class="hero">
      <div class="hero-atmosphere" aria-hidden="true">
        <div class="blob blob-lime"></div>
        <div class="blob blob-mint"></div>
      </div>
      <div class="container hero-grid">
        <div>
          <div class="hero-mascot-row">
            <img class="hero-mascot" src="/assets/mascot.png" alt="Clockd grocery scanner mascot" width="88" height="88" />
            <div>
              <p class="kicker">CLOCKD AI SCANNER</p>
              <div class="hero-badges">
                <span class="pill pill-lime">Save</span>
                <span class="pill pill-mint">List</span>
                <span class="pill pill-lime">Flip</span>
                <span class="pill pill-receipt">Receipt</span>
              </div>
            </div>
          </div>
          <h1>Worth it—or walk away.</h1>
          <p class="hero-lead">
            Clockd is a grocery price scanner for iPhone. Snap a shelf tag, compare a shopping list, or check if you
            could flip it—before you spend.
          </p>
          <div class="hero-actions">
            <a class="btn btn-lime" href={APP_STORE_URL}>Download on the App Store</a>
            <a class="btn btn-ghost" href="#how-it-works">See how it works</a>
          </div>
        </div>
        <div class="hero-phone-wrap">
          <img class="hero-phone" src="/screenshots/home.png" alt="Clockd iPhone app home screen with Scan, List, Activity, and Profile" width="460" height="929" />
        </div>
      </div>
    </section>

    <section class="section section-alt" id="how-it-works">
      <div class="container">
        <div class="section-head">
          <p class="kicker">HOW IT WORKS</p>
          <h2>Four ways to decide before you spend.</h2>
          <p>Snap an item, compare a grocery list, check resale, or log a receipt.</p>
        </div>
        <div class="steps">
          <article class="step">
            <div class="step-num">1</div>
            <h3>Snap at the shelf</h3>
            <p>Include the price tag when you can. Clockd reads the item and runs a fast Save analysis.</p>
          </article>
          <article class="step">
            <div class="step-num">2</div>
            <h3>Save: buy smart</h3>
            <p>Compare your shelf price to typical ranges, online listings, and other stores nearby—not the one you’re in.</p>
          </article>
          <article class="step">
            <div class="step-num">3</div>
            <h3>Flip: sell smart</h3>
            <p>Check resale comps, estimated profit, and marketplace links without scanning again.</p>
          </article>
          <article class="step">
            <div class="step-num">4</div>
            <h3>Receipt: log the trip</h3>
            <p>Toggle Receipt on the scanner after checkout. Clockd extracts store, line items, and total—saved in Activity.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="features">
      <div class="container feature-grid">
        <article class="feature-card">
          <div class="feature-copy">
            <span class="feature-tag">SAVE MODE</span>
            <h3>Is the shelf price worth it?</h3>
            <p>
              Get a clear deal signal, typical price range, and shop links. Add your shelf price if the tag wasn’t in
              the photo.
            </p>
          </div>
          <div class="feature-shot">
            <img src="/screenshots/save.png" alt="Clockd Save result comparing a grocery shelf price on iPhone" width="460" height="929" loading="lazy" />
          </div>
        </article>

        <article class="feature-card reverse">
          <div class="feature-copy">
            <span class="feature-tag feature-tag-lime">GROCERY LIST</span>
            <h3>Type staples. Compare once.</h3>
            <p>
              Add milk, eggs, Cheerios—then run one compare. Clockd prices the basket at nearby grocers and shows avg
              vs brand so you can pick the cheapest one-stop trip.
            </p>
          </div>
          <div class="feature-shot">
            <img src="/screenshots/list.png" alt="Clockd grocery list compare with nearby store prices" width="460" height="929" loading="lazy" />
          </div>
        </article>

        <article class="feature-card">
          <div class="feature-copy">
            <span class="feature-tag">FLIP MODE</span>
            <h3>Could you flip it for profit?</h3>
            <p>
              See estimated resale range, profit after fees, and marketplace comps on the same scan you already ran for
              Save.
            </p>
          </div>
          <div class="feature-shot">
            <img src="/screenshots/flip.png" alt="Clockd Flip result showing thrift resale profit estimate" width="460" height="929" loading="lazy" />
          </div>
        </article>

        <article class="feature-card reverse">
          <div class="feature-copy">
            <span class="feature-tag feature-tag-lime">RECEIPT TRIPS</span>
            <h3>Log the whole run.</h3>
            <p>
              Scan a receipt after checkout to capture store name, every line item, and your total. One snap—saved to
              Activity for your records.
            </p>
          </div>
          <div class="feature-shot">
            <img src="/screenshots/receipt.png" alt="Clockd receipt scanner showing store, grocery items, and total" width="460" height="929" loading="lazy" />
          </div>
        </article>

        <article class="feature-card">
          <div class="feature-copy">
            <span class="feature-tag">MY ACTIVITY</span>
            <h3>Track what you actually buy</h3>
            <p>
              Bookmark finds, mark purchased when you buy, see grocery savings and flip profit—and browse saved receipt
              trips from the last seven days.
            </p>
          </div>
          <div class="feature-shot">
            <img src="/screenshots/activity.png" alt="Clockd Activity screen with grocery savings playbook" width="460" height="929" loading="lazy" />
          </div>
        </article>

        <article class="feature-card reverse">
          <div class="feature-copy">
            <span class="feature-tag">PROFILE</span>
            <h3>Your stats, in one place.</h3>
            <p>
              See lifetime grocery saved, flip profit, lookups, and receipt trips—plus today’s scan count and shortcuts
              to Scan or Activity.
            </p>
          </div>
          <div class="feature-shot">
            <img src="/screenshots/profile.png" alt="Clockd Profile with lifetime grocery saved and flip profit" width="460" height="929" loading="lazy" />
          </div>
        </article>
      </div>
    </section>

    <section class="section section-alt" id="faq">
      <div class="container">
        <div class="section-head">
          <p class="kicker">FAQ</p>
          <h2>Grocery scanning, without the guesswork.</h2>
          <p>Short answers to how Clockd compares prices on iPhone.</p>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band">
      <h2>Stop guessing in the aisle.</h2>
      <p>
        Clockd is free to download on iPhone. Free includes a daily analysis limit. Clockd Pro unlocks 60 analyses per
        day and ad-free analyzing.
      </p>
      <a class="btn btn-lime" href={APP_STORE_URL}>Get Clockd on the App Store</a>
    </section>
  </main>
</BaseLayout>
