---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  APP_STORE_RATING,
  APP_STORE_RATING_COUNT,
  APP_STORE_URL,
  CTA_MICRO,
  CTA_PRIMARY,
} from '../data/site';

const faqs = [
  {
    q: 'What is Clockd?',
    a: 'Clockd is an iPhone app that tells you if a shelf price is worth it. Snap the tag, see a deal signal and typical prices, then buy or walk.',
  },
  {
    q: 'How does a scan work?',
    a: 'Photograph the item with the price tag in frame when you can. Clockd identifies it and shows a typical range plus online prices. Results are estimates, not live register prices.',
  },
  {
    q: 'What else can I do?',
    a: 'Same app: type a grocery list and compare nearby stores, check resale on the same photo, or snap a receipt after checkout. You do not have to use those until you want them.',
  },
  {
    q: 'Is Clockd free?',
    a: 'Yes. Clockd is free on the App Store, with a daily scan limit. Clockd Pro raises that limit and removes ads while analyzing. No credit card needed to download.',
  },
];

const testimonials = [
  {
    quote: 'One snap and I knew the shelf tag wasn’t a deal. Put it back before I wasted the trip.',
    name: 'Alex M.',
    detail: 'Early tester · grocery shopper',
    initials: 'AM',
  },
  {
    quote: 'I typed my staples, compared nearby stores, and picked the cheaper one-stop trip in under a minute.',
    name: 'Jordan L.',
    detail: 'Early tester · list compare',
    initials: 'JL',
  },
  {
    quote: 'Scanned a thrift find, flipped to resale on the same photo, and skipped a bad buy.',
    name: 'Riley S.',
    detail: 'Early tester · Flip',
    initials: 'RS',
  },
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const stars = '★★★★★';
---

<BaseLayout jsonLd={faqLd}>
  <main id="main">
    <section class="hero">
      <div class="hero-atmosphere" aria-hidden="true">
        <div class="blob blob-lime"></div>
        <div class="blob blob-mint"></div>
      </div>
      <div class="container hero-grid">
        <div>
          <div class="hero-mascot-row">
            <img class="hero-mascot" src="/assets/mascot.png" alt="Clockd grocery scanner mascot" width="88" height="88" />
            <div>
              <p class="kicker">GROCERY PRICE SCANNER</p>
              <a class="rating-chip" href={APP_STORE_URL} aria-label={`Rated ${APP_STORE_RATING} out of 5 on the App Store from ${APP_STORE_RATING_COUNT} ratings`}>
                <span class="rating-stars" aria-hidden="true">{stars}</span>
                <span>{APP_STORE_RATING.toFixed(1)} · {APP_STORE_RATING_COUNT} App Store ratings</span>
              </a>
            </div>
          </div>
          <h1>Stop overpaying at the grocery store. Clockd tells you in one snap.</h1>
          <p class="hero-lead">
            Snap a shelf tag and instantly see if you’re overpaying — then buy or walk.
            Worth it—or walk away. Free on iPhone.
          </p>
          <div class="hero-actions">
            <div class="cta-stack">
              <a class="btn btn-lime" href={APP_STORE_URL}>{CTA_PRIMARY}</a>
              <p class="cta-micro">{CTA_MICRO}</p>
            </div>
            <a class="btn btn-ghost" href="#how-it-works">See how it works</a>
          </div>
        </div>
        <div class="hero-phone-wrap">
          <img
            class="hero-phone"
            src="/screenshots/save.png"
            alt="Clockd Save result: Solid Deal on Kirkland yogurt with Walmart, Target, and Amazon price comps"
            width="460"
            height="929"
          />
          <p class="hero-caption">Real in-app scan — deal signal + online comps</p>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="how-it-works">
      <div class="container">
        <div class="section-head">
          <p class="kicker">HOW IT WORKS</p>
          <h2>Three steps in the aisle.</h2>
          <p>No modes to pick up front. Point, scan, decide.</p>
        </div>
        <div class="steps">
          <article class="step">
            <div class="step-num">1</div>
            <h3>Snap the tag</h3>
            <p>Photograph the item. Include the shelf price when you can.</p>
          </article>
          <article class="step">
            <div class="step-num">2</div>
            <h3>See the deal</h3>
            <p>Get a clear signal, a typical price range, and online comps.</p>
          </article>
          <article class="step">
            <div class="step-num">3</div>
            <h3>Buy or walk</h3>
            <p>If it isn’t worth it, put it back. If it is, check out with confidence.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="see-it">
      <div class="container">
        <div class="section-head">
          <p class="kicker">IN THE APP</p>
          <h2>See the product, not just the pitch.</h2>
          <p>One scan can Save, Flip, compare a list, or log a receipt — no other grocery app stacks those in one place.</p>
        </div>
        <div class="shot-strip">
          <figure class="shot-card">
            <img src="/screenshots/save.png" alt="Clockd Save mode deal signal and online compare" width="460" height="929" loading="lazy" />
            <figcaption>Save — shelf vs online</figcaption>
          </figure>
          <figure class="shot-card">
            <img src="/screenshots/list.png" alt="Clockd grocery list compare across nearby stores" width="460" height="929" loading="lazy" />
            <figcaption>List — cheapest one-stop trip</figcaption>
          </figure>
          <figure class="shot-card">
            <img src="/screenshots/receipt.png" alt="Clockd receipt trip with store, items, and total" width="460" height="929" loading="lazy" />
            <figcaption>Receipt — log the whole run</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="social-proof">
      <div class="container">
        <div class="section-head">
          <p class="kicker">EARLY FEEDBACK</p>
          <h2>Shoppers who hate guessing in the aisle.</h2>
          <p>
            Rated {APP_STORE_RATING.toFixed(1)} on the App Store.
            <a href={APP_STORE_URL}>Leave a review</a> after your first scan — it helps the next shopper trust Clockd.
          </p>
        </div>
        <div class="testimonial-grid">
          {testimonials.map((t) => (
            <blockquote class="testimonial">
              <div class="testimonial-avatar" aria-hidden="true">{t.initials}</div>
              <p class="testimonial-quote">“{t.quote}”</p>
              <footer>
                <cite class="testimonial-name">{t.name}</cite>
                <span class="testimonial-detail">{t.detail}</span>
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="features">
      <div class="container feature-grid">
        <article class="feature-card">
          <div class="feature-copy">
            <span class="feature-tag">THE SCAN</span>
            <h3>Is the shelf price worth it?</h3>
            <p>
              That is the whole app the first time you open it. Clockd names the item, shows a typical range, and
              compares Amazon, Walmart, and Target so you can decide in seconds.
            </p>
          </div>
          <div class="feature-shot">
            <img src="/screenshots/flip.png" alt="Clockd Flip result with resale profit estimate" width="460" height="929" loading="lazy" />
          </div>
        </article>
      </div>

      <div class="container also">
        <p class="also-kicker">Later, if you want</p>
        <div class="also-grid">
          <article class="also-card">
            <h3>Grocery list</h3>
            <p>Type milk, eggs, Cheerios. Clockd prices the basket at nearby stores.</p>
          </article>
          <article class="also-card">
            <h3>Flip</h3>
            <p>Same photo, resale range and estimated profit—for thrift finds.</p>
          </article>
          <article class="also-card">
            <h3>Receipts</h3>
            <p>Snap the tape after checkout. Clockd logs the store, items, and total.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="faq">
      <div class="container">
        <div class="section-head">
          <p class="kicker">FAQ</p>
          <h2>Simple answers.</h2>
          <p>What Clockd is, how a scan works, and what it costs.</p>
        </div>
        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band">
      <h2>Scan your first item today.</h2>
      <p>Free on iPhone. No credit card to download. Daily scan limit on free — Pro if you scan a lot.</p>
      <div class="cta-stack cta-stack-center">
        <a class="btn btn-lime" href={APP_STORE_URL}>{CTA_PRIMARY}</a>
        <p class="cta-micro cta-micro-on-dark">{CTA_MICRO}</p>
      </div>
    </section>
  </main>
</BaseLayout>
