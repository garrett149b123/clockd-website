---
import Analytics from '@vercel/analytics/astro';
import {
  APP_STORE_ID,
  APP_STORE_URL,
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  DEFAULT_TITLE,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  SITE_URL,
  SUPPORT_EMAIL,
} from '../data/site';
import type { AppStoreRating } from '../lib/appStoreRating';
import { FALLBACK_APP_STORE_RATING } from '../lib/appStoreRating';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** SoftwareApplication extras (rarely needed). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Standalone FAQPage JSON-LD for rich results. */
  faqJsonLd?: Record<string, unknown>;
  /** Live or fallback App Store rating for schema + page. */
  appStoreRating?: AppStoreRating;
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  jsonLd,
  faqJsonLd,
  appStoreRating = FALLBACK_APP_STORE_RATING,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE_URL).href;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const softwareLd = {
  '@type': 'SoftwareApplication',
  name: 'Clockd AI Scanner',
  applicationCategory: 'ShoppingApplication',
  operatingSystem: 'iOS',
  url: SITE_URL,
  downloadUrl: APP_STORE_URL,
  image: ogImageUrl,
  description,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: appStoreRating.rating,
    ratingCount: appStoreRating.count,
    bestRating: 5,
    worstRating: 1,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: 'Garrett Spoor',
    email: SUPPORT_EMAIL,
    url: SITE_URL,
  },
  sameAs: [APP_STORE_URL, INSTAGRAM_URL],
};

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdPayload = {
  '@context': 'https://schema.org',
  '@graph': [softwareLd, ...extraLd],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="UStUZVb9vMAgtwcrdEtoTOvdvh7OL5LSqpqU-eGG_P8" />
    <meta name="theme-color" content="#84cc16" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/mascot.webp" type="image/webp" />
    <link rel="icon" href="/assets/mascot.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/mascot.png" />
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />
    {isHome && (
      <>
        <link rel="preload" as="image" href="/screenshots/save.webp" type="image/webp" fetchpriority="high" />
        <link rel="preload" as="image" href="/screenshots/home.webp" type="image/webp" />
      </>
    )}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Clockd" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Clockd grocery price scanner app on iPhone" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPayload)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    <Analytics />
  </head>
  <body data-app-store-id={APP_STORE_ID}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">⏰</span>
          <span>CLOCKD</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a class="hide-mobile" href="/#how-it-works">How it works</a>
          <a class="hide-mobile" href="/#see-it">See it</a>
          <a class="hide-mobile" href="/#built-by">Built by</a>
          <a class="hide-mobile" href="/#faq">FAQ</a>
          <a class="btn btn-lime" href={APP_STORE_URL}>Download free</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-grid">
        <p>© {new Date().getFullYear()} Garrett Spoor · Clockd AI Scanner</p>
        <div class="footer-links">
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">Instagram {INSTAGRAM_HANDLE}</a>
          <a href="/#built-by">About</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href={`mailto:${SUPPORT_EMAIL}`}>Support</a>
          <a href={APP_STORE_URL}>App Store</a>
        </div>
      </div>
    </footer>
    {isHome && <script src="/app-store-rating.js" defer></script>}
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
